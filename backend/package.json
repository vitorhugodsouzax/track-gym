{
  "name": "@memento-mori/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/prisma.mjs migrate dev",
    "prisma:seed": "node scripts/prisma.mjs seed"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "6.19.0",
    "dotenv": "latest",
    "fastify": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "prisma": "6.19.0",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
